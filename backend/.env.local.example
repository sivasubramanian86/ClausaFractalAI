GOOGLE_CLOUD_PROJECT=genai-apac-2026-491004
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Verified Active Models (Gemini 3.8)
ROUTER_MODEL=gemini-3.8-flash-001
