# ==============================================================================
# ClausaFractalAI Backend — Environment Configuration Template
# ==============================================================================
# Zero-Key Standard: Authenticates via Google Cloud Application Default Credentials (ADC)
# and Gemini Enterprise Agent Platform (Vertex AI).
# DO NOT commit production API keys or credentials to git.
# ==============================================================================

# Google Cloud Platform & Gemini Enterprise Agent Platform (Vertex AI)
GOOGLE_CLOUD_PROJECT=genai-apac-2026-491004
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Model Topology (Verified Active on GenAI-APAC-2026 Project)
ROUTER_MODEL=gemini-2.5-flash
ANALYST_MODEL=gemini-2.5-flash
SYNTHESIS_MODEL=gemini-2.5-pro

# Context Caching Threshold (Tokens)
CONTEXT_CACHING_THRESHOLD=32768

# Application Configuration
APP_NAME=ClausaFractalAI
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Agent Framework & Multi-Agentic RAG
AGENT_FRAMEWORK=google-adk
CRITIC_REFLECTION_ENABLED=true
CRITIC_MIN_SCORE=8.0
VECTOR_DIMENSION=768
