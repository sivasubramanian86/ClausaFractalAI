# ==============================================================================
# ClausaFractalAI — Root Monorepo Environment Configuration Template
# ==============================================================================
# In production and local development, DO NOT set static API keys.
# ClausaFractalAI utilizes the Gemini Enterprise Agent Platform (Vertex AI)
# with Application Default Credentials (ADC) on project genai-apac-2026-491004.
# ==============================================================================

# Google Cloud Platform (GenAI-APAC-2026)
GOOGLE_CLOUD_PROJECT=genai-apac-2026-491004
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Verified Active Models
ROUTER_MODEL=gemini-2.5-flash
ANALYST_MODEL=gemini-2.5-flash
SYNTHESIS_MODEL=gemini-2.5-pro

# Framework Settings
AGENT_FRAMEWORK=google-adk
CRITIC_REFLECTION_ENABLED=true
CRITIC_MIN_SCORE=8.0
CONTEXT_CACHING_THRESHOLD=32768

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
